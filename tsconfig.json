{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["tests/pages/*"],
      "@elements/*": ["tests/elements/*"],
      "@support/*": ["tests/support/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@steps/*": ["tests/steps/*"],
      "@data/*": ["tests/fixtures/data/*"]
    }
  },
  "include": ["tests/**/*", "playwright.config.ts"]
}
