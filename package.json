{
  "name": "my-playwright-project",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test tests/specs/login-ui.spec.ts --headed",
    "test:auth": "npx playwright test tests/specs/login-auth.spec.ts --headed",
    "test:forgot": "npx playwright test tests/specs/forgot-password.spec.ts --headed",
    "test:logout": "npx playwright test tests/specs/logout.spec.ts --headed",
    "test:security": "npx playwright test tests/specs/security.spec.ts --headed",
    "report": "allure serve allure-results",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:playwright": "npx playwright show-report"
  },
